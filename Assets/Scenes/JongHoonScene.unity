  m_Text: "\xB7 \uB9B0 \u25B6 \uB178\uC544 (\uB178\uC544 \uC528\uC758 \uC9C8\uBB38\uB4E4\uC774
    \uC9C0\uB098\uCE58\uAC8C \uC758\uC2EC\uC2A4\uB7FD\uACE0, \uBBF8\uB85C \uC528\uC5D0\uAC8C
    \uC815\uBCF4\uB97C \uC804\uB2EC\uD558\uB294 \uACFC\uC815\uC5D0 \uB300\uD55C \uC124\uBA85\uC774
